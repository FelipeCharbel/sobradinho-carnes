<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<script>
/* se o código da página falhar ao carregar, mostra o motivo na tela (em vez de uma tela "morta") */
(function () {
  function mostra(msg) {
    var d = document.getElementById("erroCarga");
    if (!d) { d = document.createElement("pre"); d.id = "erroCarga"; d.style.cssText = "position:fixed;z-index:99999;left:12px;right:12px;bottom:12px;max-height:40vh;overflow:auto;margin:0;padding:12px 14px;border-radius:10px;background:#7a0010;color:#fff;font:12px/1.4 monospace;white-space:pre-wrap";
      (document.body || document.documentElement).appendChild(d); }
    d.textContent = "Erro ao carregar a plataforma:\n" + msg;
  }
  window.addEventListener("error", function (e) { mostra((e.message || "erro") + (e.lineno ? "  (linha " + e.lineno + ", coluna " + e.colno + ")" : "")); });
  window.addEventListener("unhandledrejection", function (e) { mostra(String(e.reason && e.reason.message || e.reason)); });
})();
</script>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Gestão Sobradinho Carnes</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Faustina:ital,wght@0,500;0,600;1,500;1,700&family=Inter:wght@400;500;600&display=swap">
<style>
:root{
  --bg:#F6F6F4; --surface:#FFFFFF; --sunk:#EFEEEB; --line:#E3E1DD; --line-2:#D3D1CC;
  --ink:#1C1C1C; --ink-2:#323232; --muted:#6B6966; --faint:#8A8885;
  --red:#E2010F; --red-dark:#B9010C; --red-ink:#C0000C; --red-soft:#F8ECEC; --red-line:#E8BDBF;   /* vermelho da marca: só como sinal */
  --deep:#A0141C; --deep-2:#80101A;                                                                /* bordô: áreas grandes */
  --graphite:#211F1F; --graphite-2:#2E2B2B;                                                        /* grafite quente: estrutura */
  --ok:#1F7A3A; --ok-soft:#E4F2E8; --warn:#8F5600; --warn-soft:#FBEFD9; --info:#2D5A87; --info-soft:#E4ECF5;
  --nv1:#1F1F1F; --nv2:#4B4B4B; --nv3:#8C8C8C; --nv4:#C4C4C4; --nv5:#F2F2F0;   /* escala de nível do organograma: topo → base */
  --st-ok:#2FA35A; --st-warn:#E0A030; --st-sem:#9A9893;                          /* bolinha de status na caixa */
  --shadow-1:0 1px 2px rgba(40,24,24,.05),0 2px 8px rgba(40,24,24,.04);
  --shadow-2:0 2px 6px rgba(40,24,24,.06),0 14px 32px rgba(40,24,24,.10);
  --shadow-3:0 24px 64px rgba(30,16,16,.22);
  --f:"Archivo",ui-sans-serif,system-ui,"Segoe UI",sans-serif;
  --ease:cubic-bezier(.16,1,.3,1);
  --side-w:248px;
  color-scheme:light;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%}
body{background:var(--bg);color:var(--ink);font-family:var(--f);font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums}
button,input,select,textarea{font:inherit;color:inherit}
h1,h2,h3{margin:0;font-weight:750;letter-spacing:-.02em;line-height:1.1;text-wrap:balance}
p{margin:0}
::selection{background:var(--red);color:#fff}
input,textarea{caret-color:var(--red)}
*::-webkit-scrollbar{width:10px;height:10px}
*::-webkit-scrollbar-thumb{background:var(--line-2);border-radius:99px;border:3px solid transparent;background-clip:content-box}
*::-webkit-scrollbar-track{background:transparent}
:focus-visible{outline:2px solid var(--red);outline-offset:2px;border-radius:4px}
[hidden]{display:none!important}
.ic{width:18px;height:18px;flex:none;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.hint{font-size:13px;color:var(--muted)}
.label{font-size:12px;font-weight:650;color:var(--muted)}

/* ---------- botões e campos ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;padding:0 16px;border-radius:10px;border:1px solid var(--line-2);background:var(--surface);color:var(--ink);cursor:pointer;font-weight:600;font-size:14.5px;white-space:nowrap;text-decoration:none;transition:background .18s var(--ease),border-color .18s,transform .12s var(--ease)}
.btn:hover{border-color:var(--ink-2)}
.btn:active{transform:scale(.98)}
.btn.primary{background:var(--graphite);border-color:var(--graphite);color:#fff}
.btn.primary:hover{background:var(--graphite-2);border-color:var(--graphite-2)}
.btn.light{background:#fff;border-color:#fff;color:var(--deep)}
.btn.light:hover{background:#fff;border-color:#fff;box-shadow:0 8px 24px rgba(0,0,0,.2)}
.btn.glass{background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.35);color:#fff}
.btn.glass:hover{background:rgba(255,255,255,.24);border-color:#fff}
.btn.ghost{background:transparent;border-color:transparent;color:var(--muted)}
.btn.ghost:hover{background:var(--sunk);color:var(--ink)}
.btn.sm{height:32px;padding:0 12px;font-size:13.5px;border-radius:8px}
.btn.icon{width:40px;padding:0}
.btn.sm.icon{width:32px}
.btn:disabled{opacity:.45;cursor:default}
.field{display:grid;gap:6px}
.field input,.field select,.field textarea,.inp{width:100%;height:42px;padding:0 12px;border:1px solid var(--line-2);border-radius:10px;background:var(--surface)}
.field textarea{height:auto;min-height:96px;padding:10px 12px;resize:vertical;line-height:1.45}
.field input:focus,.field select:focus,.field textarea:focus,.inp:focus{outline:none;border-color:var(--red);box-shadow:0 0 0 3px var(--red-soft)}
::placeholder{color:var(--faint)}
.linkbtn{border:0;background:none;padding:0;color:var(--red-ink);font-weight:650;cursor:pointer;font-size:14px;text-align:left}
.linkbtn:hover{text-decoration:underline}

/* ---------- LOGIN (escuro, como o artefato) ---------- */
#login{--bg:#131313;--surface:#1B1B1B;--line:#2E2E2E;--line-2:#3A3A3A;--ink:#F1F0EE;--muted:#A8A6A2;--faint:#8E8C88;--red-ink:#FF5A63;--red-soft:#33171A;--shadow-2:0 2px 6px rgba(0,0,0,.35),0 14px 32px rgba(0,0,0,.35);
  min-height:100dvh;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(380px,.85fr);background:var(--surface);color:var(--ink)}
#login .field input{background:#232323}
#login .btn.primary{background:var(--red);border-color:var(--red)}
#login .btn.primary:hover{background:var(--red-dark);border-color:var(--red-dark)}
.login-art{position:relative;overflow:hidden;background:#0E0E0E;color:#fff;display:flex;flex-direction:column;justify-content:flex-end;padding:48px;min-height:320px;isolation:isolate}
.login-art .seal{position:absolute;z-index:-1;right:-10%;top:-9%;width:min(62vh,58%);aspect-ratio:1;filter:drop-shadow(0 30px 60px rgba(0,0,0,.45));animation:sealInL 1.1s var(--ease) both}
.login-art .stripe{position:absolute;z-index:-1;left:0;right:0;bottom:0;height:42%;background:linear-gradient(120deg,var(--red-dark),var(--red));clip-path:polygon(0 38%,100% 0,100% 100%,0 100%)}
.login-art h1{font-size:clamp(44px,6.4vw,92px);font-weight:900;font-stretch:112%;letter-spacing:-.035em;line-height:.92;max-width:9ch;text-transform:uppercase;animation:rise .9s .15s var(--ease) both}
.login-art p{margin-top:16px;max-width:38ch;color:rgba(255,255,255,.88);font-size:16px;animation:rise .9s .28s var(--ease) both}
.login-panel{display:flex;flex-direction:column;justify-content:center;padding:48px clamp(28px,5vw,72px);gap:26px}
.brandrow{display:flex;align-items:center;gap:12px}
.brandrow img{width:44px;height:44px}
.brandrow b{display:block;font-weight:800;font-size:16px;letter-spacing:-.01em}
.brandrow span{font-size:13px;color:var(--muted)}
.login-panel h2{font-size:30px;letter-spacing:-.025em}
.login-panel .lead{color:var(--muted);margin-top:6px;max-width:40ch}
#loginForm{display:grid;gap:14px;max-width:400px}
.err{color:var(--red-ink);font-size:13.5px;font-weight:600;min-height:1.2em}
.or{display:flex;align-items:center;gap:12px;color:var(--muted);font-size:13px;max-width:400px}
.or::before,.or::after{content:"";flex:1;height:1px;background:var(--line)}
.demo-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;max-width:400px}
#login .seg{background:#232323}
#login .seg button{color:#A8A6A2}
#login .seg button[aria-pressed="true"]{background:#383838;color:#fff;box-shadow:none}
#login form{display:grid;gap:14px;max-width:400px}
.pa-adm{font-size:13px;color:var(--muted)}
.pa-adm summary{cursor:pointer}
/* seletor de cargo (primeiro acesso) */
.cg{display:grid;gap:8px}
.cg [hidden]{display:none!important}
.cg input[type="search"]{width:100%;height:42px;padding:0 12px;border:1px solid var(--line-2);border-radius:10px;background:var(--surface);color:var(--ink);font:inherit;font-size:15px}
.cg input[type="search"]:focus{outline:none;border-color:var(--red);box-shadow:0 0 0 3px var(--red-soft)}
.cg-lista{max-height:260px;overflow:auto;overscroll-behavior:contain;border:1px solid var(--line-2);border-radius:12px;background:var(--surface);padding:4px}
.cg-lista:empty{display:none}
.cg-grupo+.cg-grupo{border-top:1px solid var(--line)}
.cg-area{position:sticky;top:0;z-index:1;background:var(--surface);padding:8px 10px 4px;font-size:11.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--muted)}
.cg-op{display:grid;gap:2px;padding:9px 10px;border-radius:9px;cursor:pointer;scroll-margin:40px}
.cg-op b{font-weight:600;font-size:14.5px;line-height:1.3;overflow-wrap:anywhere}
.cg-op small{font-size:12.5px;color:var(--muted);line-height:1.3}
.cg-op:hover{background:var(--sunk)}
.cg-op.foco{box-shadow:inset 0 0 0 2px var(--line-2)}
.cg-op[aria-selected="true"]{background:var(--red-soft);box-shadow:inset 3px 0 0 var(--red)}
.cg-op[aria-selected="true"] small{color:var(--ink-2)}
.cg-st{margin:0;padding:12px 10px;display:flex;flex-wrap:wrap;gap:10px;align-items:center;font-size:14px}
.cg-esc{display:flex;flex-wrap:wrap;gap:10px 12px;align-items:center;justify-content:space-between;border:1px solid var(--line-2);border-left:4px solid var(--red);border-radius:12px;background:var(--surface);padding:10px 12px}
.cg-esc p{margin:0;font-size:14.5px;min-width:0;flex:1 1 200px;overflow-wrap:anywhere}
.cg-duvida{display:flex;gap:10px;align-items:center;font-size:14px;color:var(--ink-2);cursor:pointer}
.cg-duvida input{width:18px;height:18px;margin:0;flex:none;accent-color:var(--red)}
.cg-duv{color:var(--warn)}
.ok-msg{background:var(--ok-soft);color:var(--ok);border-radius:10px;padding:12px 14px;font-weight:600;font-size:14px}
.demo{display:grid;gap:2px;text-align:left;padding:11px 14px;border:1px solid var(--line-2);border-radius:12px;background:#232323;cursor:pointer;transition:border-color .18s,box-shadow .18s,transform .12s}
.demo:hover{border-color:var(--red);box-shadow:var(--shadow-2)}
.demo:active{transform:scale(.98)}
.demo b{font-weight:700;font-size:14px}
.demo span{font-size:12.5px;color:var(--muted)}
.login-foot{font-size:12.5px;color:var(--muted);max-width:400px}
@media (max-width:860px){#login{grid-template-columns:1fr}.login-art{min-height:44vh;padding:28px}.login-art .seal{width:70%;right:-18%;top:-16%}.login-panel{padding:28px 20px 40px}}

/* ---------- CASCA (clara) ---------- */
#app{min-height:100dvh;display:grid;grid-template-columns:var(--side-w) minmax(0,1fr)}
.side{position:sticky;top:0;height:100dvh;background:var(--surface);border-right:1px solid var(--line);display:flex;flex-direction:column;padding:16px 12px;gap:8px;z-index:12}
.side-brand{display:flex;align-items:center;gap:10px;padding:4px 6px 14px;border-bottom:1px solid var(--line)}
.side-brand img{width:40px;height:40px;flex:none}
.side-brand b{display:block;font-weight:800;font-size:15px;white-space:nowrap}
.side-brand span{display:block;font-size:12px;color:var(--muted)}
nav.rail{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:2px;padding-top:6px}
.rail-sep{font-size:11.5px;font-weight:650;color:var(--faint);padding:14px 10px 6px}
.tag-fn{display:inline-block;margin-left:8px;font-size:11px;font-weight:700;color:var(--red-ink);background:var(--red-soft);border-radius:99px;padding:1px 8px}
.fn-resp{display:block;color:var(--muted);margin-top:2px}
.sel-pai{min-width:240px;max-width:100%;font-family:inherit}
.tb-lista{margin:0;padding-left:16px;display:grid;gap:4px;font-size:13px;line-height:1.4}
.tb-mud{margin-top:10px;border:1px solid var(--warn);background:var(--warn-soft);border-radius:12px;padding:10px 12px;display:grid;gap:8px}
.tb-mud summary{cursor:pointer;font-weight:700;color:var(--warn);font-size:13px}
.tb-seta{color:var(--muted)}
.tb-del{color:var(--muted);text-decoration:line-through}
.tb-add{font-weight:600}
.rail-sub{font-size:11.5px;font-weight:650;color:var(--faint);padding:10px 10px 2px}
.vz-lista{max-height:320px;overflow:auto;border:1px solid var(--line);border-radius:12px;padding:8px;background:var(--surface)}
.vz-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:8px}
.vz-card{text-align:left;border:1px solid var(--line-2);background:var(--surface);border-radius:12px;padding:10px 12px;display:grid;gap:2px;cursor:pointer;font:inherit;color:inherit}
.vz-card b{font-size:14px;line-height:1.25}
.vz-card span{font-size:12.5px;color:var(--muted)}
.vz-card:hover{border-color:var(--red)}
.vz-card.on{border-color:var(--red);background:var(--red-soft)}
nav.rail button{position:relative;display:flex;align-items:center;gap:12px;width:100%;text-align:left;height:42px;padding:0 10px;border:0;border-radius:10px;background:transparent;color:var(--muted);cursor:pointer;transition:background .15s,color .15s}
nav.rail button .ic{width:20px;height:20px}
nav.rail button b{font-weight:650;flex:1;white-space:nowrap}
nav.rail button:hover{background:var(--sunk);color:var(--ink)}
nav.rail button[aria-current="page"]{background:var(--sunk);color:var(--ink)}
nav.rail button[aria-current="page"] .ic{color:var(--red)}
nav.rail button[aria-current="page"]::before{content:"";position:absolute;left:-12px;top:10px;bottom:10px;width:3px;border-radius:0 3px 3px 0;background:var(--red)}
nav.rail .count{font-size:12px;font-weight:700;background:var(--red);color:#fff;border-radius:99px;padding:0 7px}
.side-foot{border-top:1px solid var(--line);padding:12px 4px 0;display:flex;align-items:center;gap:10px}
.avatar{width:36px;height:36px;border-radius:50%;background:var(--graphite);display:grid;place-items:center;font-weight:700;font-size:13px;flex:none;color:#fff}
.side-foot .who{flex:1;min-width:0;line-height:1.25}
.side-foot .who b{display:block;font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.side-foot .who span{font-size:12px;color:var(--muted)}
.mainwrap{min-width:0;display:flex;flex-direction:column}
.topbar{position:sticky;top:0;z-index:10;display:flex;align-items:center;gap:10px;height:64px;padding:0 28px;background:color-mix(in srgb,var(--bg) 85%,transparent);backdrop-filter:saturate(1.4) blur(10px);-webkit-backdrop-filter:saturate(1.4) blur(10px);border-bottom:1px solid var(--line)}
.crumb{font-weight:700;font-size:15px;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.access-chip{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:650;color:var(--muted);background:var(--surface);border:1px solid var(--line);border-radius:99px;padding:5px 11px;white-space:nowrap}
.access-chip .ic{width:14px;height:14px;color:var(--red)}
#menuBtn{display:none}
main{padding:20px 28px 64px;min-width:0}
.wrap{max-width:1200px;margin:0 auto;display:grid;gap:22px}
.page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px 24px;flex-wrap:wrap}
.page-head>div{flex:1 1 320px;min-width:0}
.page-head h2{font-size:34px;font-weight:800;letter-spacing:-.03em}
.page-head p{margin-top:8px;color:var(--muted);max-width:68ch}
.view-enter{animation:viewIn .32s var(--ease) both}
.menu-scrim{position:fixed;inset:0;background:rgba(15,10,10,.4);z-index:11;animation:fade .2s both}
@media (max-width:900px){
  #app{grid-template-columns:1fr}
  .side{position:fixed;left:0;top:0;bottom:0;width:272px;transform:translateX(-102%);transition:transform .28s var(--ease);box-shadow:var(--shadow-3)}
  #app.menu-open .side{transform:none}
  #menuBtn{display:inline-flex}
  .topbar{padding:0 16px}
  main{padding:16px 16px 56px}
  .page-head h2{font-size:28px}
  .access-chip span{display:none}
}

/* ---------- peças ---------- */
.panel{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:20px 22px;min-width:0}
.panel-h{display:flex;justify-content:space-between;align-items:baseline;gap:10px 16px;margin-bottom:14px;flex-wrap:wrap}
.panel-h h3{font-size:18px}
.grid2{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:20px}
.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
@media (max-width:1020px){.grid2{grid-template-columns:1fr}.grid3{grid-template-columns:1fr 1fr}}
@media (max-width:620px){.grid3{grid-template-columns:1fr}}
.pill{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:650;padding:3px 9px;border-radius:99px;white-space:nowrap;line-height:1.3}
.pill.ok{background:var(--ok-soft);color:var(--ok)}
.pill.warn{background:var(--warn-soft);color:var(--warn)}
.pill.info{background:var(--info-soft);color:var(--info)}
.pill.bad{background:var(--red-soft);color:var(--red-ink)}
.pill.neutral{background:var(--sunk);color:var(--muted)}
.pill.dot::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
.empty-state{border:1px dashed var(--line-2);border-radius:16px;padding:32px 24px;text-align:center;color:var(--muted);display:grid;gap:8px;justify-items:center;background:var(--surface)}
.empty-state .ic{width:28px;height:28px;color:var(--faint)}
.notice{display:flex;gap:12px;align-items:center;background:var(--info-soft);border-radius:12px;padding:12px 16px;font-size:14px}
.notice .ic{color:var(--info)}
.notice.warn{background:var(--warn-soft)}.notice.warn .ic{color:var(--warn)}
.notice .sp{flex:1}
.sec{font-size:13px;font-weight:750;margin:6px 0 -6px;display:flex;align-items:center;gap:8px}
.sec::after{content:"";flex:1;height:1px;background:var(--line)}
.sec .dot{width:8px;height:8px;border-radius:50%;background:var(--red)}
.toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.toolbar .inp{max-width:340px;height:40px}
.seg{display:inline-flex;padding:3px;border-radius:12px;background:var(--sunk);gap:2px;flex-wrap:wrap}
.seg button{border:0;background:transparent;height:34px;padding:0 14px;border-radius:9px;font-weight:600;font-size:14px;cursor:pointer;color:var(--muted)}
.seg button[aria-pressed="true"]{background:var(--surface);color:var(--ink);box-shadow:var(--shadow-1)}
.card{display:flex;flex-direction:column;gap:8px;text-align:left;border:1px solid var(--line);background:var(--surface);border-radius:14px;padding:16px 18px;cursor:pointer;font:inherit;color:inherit;transition:border-color .18s,box-shadow .18s,transform .18s var(--ease)}
.card:hover{border-color:var(--red-line);box-shadow:var(--shadow-2);transform:translateY(-2px)}
.card h3{font-size:17px}
.card .who{font-size:13.5px;color:var(--ink-2)}
.card p{color:var(--muted);font-size:13.5px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.card .pills{display:flex;gap:6px;flex-wrap:wrap;margin-top:auto}
.card.pend{border-style:dashed;background:transparent}
